# OpsVision environment configuration
# Copy this file to `.env` (which is gitignored) and fill in your real values:
#   Copy-Item .env.example .env
#
# Docker Compose reads these variables automatically from the `.env` file
# in this directory. `scripts/run-demo.ps1` picks them up as well.

# ============================================================
# GitHub integration (optional for the demo — required for real repos)
# ------------------------------------------------------------
# Create a Personal Access Token (PAT) at:
#   https://github.com/settings/tokens
#
# Permissions needed:
#   - Classic PAT: scope `repo` (full control of private repositories)
#   - Fine-grained PAT: "Issues" Read & write + "Metadata" Read-only
#     on the specific repository you want integrated
#
# Leave empty to run the demo without GitHub integration.
# ============================================================
GITHUB_API_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=

# ============================================================
# AI analysis (optional for the demo)
# ------------------------------------------------------------
# OPSVISION_AI_ENABLED=true enables AI-powered deployment analysis.
# Provider options: ollama | openai
# ============================================================
OPSVISION_AI_ENABLED=false
OPSVISION_AI_PROVIDER=none
OPSVISION_OLLAMA_BASE_URL=http://ollama:11434
OPSVISION_OLLAMA_MODEL=llama3.2
OPSVISION_AI_BASE_URL=https://api.openai.com/v1
OPSVISION_AI_API_KEY=
OPSVISION_AI_MODEL=gpt-4o-mini

# ============================================================
# Observability / monitoring
# ============================================================
OPSVISION_OBSERVABILITY_ENABLED=true
# Prometheus service selector determines which workload OpsVision
# watches for the demo incident scenarios (see prometheus.yml).
OPSVISION_PROMETHEUS_SERVICE_SELECTOR=job="opsvision-demo-app"
</write_to_file>

